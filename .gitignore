# ============================================================================
# Grex - what does NOT belong in the repository
#
# The repo needs exactly three things to build on CI: CMakeLists.txt, src/ and
# assets/.  Everything below is either generated, downloaded, huge, or private.
#
# NOTE: save this file as ".gitignore" (leading dot).  Windows Explorer refuses
# to rename a file to a leading dot - use `ren _gitignore .gitignore` from cmd,
# and `dir /a` to see it afterwards, since plain `dir` hides dot-files.
# ============================================================================

# ---- Build output ----------------------------------------------------------
build/
build_*/
out/
x64/
Debug/
Release/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
*_artefacts/

# ---- IDE / editor ----------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# ---- Dependencies fetched at build time ------------------------------------
# The workflow git-clones both of these into libs/ on every run, and locally
# they are your own checkouts.  Committing them would add hundreds of MB and
# then go stale - and a committed libs/JUCE makes the workflow's
# `git clone ... libs/JUCE` fail outright with "destination path already exists
# and is not an empty directory".
libs/
JUCE/
ASIOSDK/

# ---- JUCE generated --------------------------------------------------------
**/JuceLibraryCode/

# ---- SAMPLE AND STYLE LIBRARIES - never commit ------------------------------
# These are the two that would actually break the repository.  The .frb blobs
# and the style library are hundreds of MB and are content, not code.
# .fgt is Grex's own (encrypted) style format - the library itself.
sounds/
sounds_gm/
styles/
Sounds/
Styles/
*.frb
*.sfz
*.fst
*.fgt
*.sty
*.STY
*.prs
*.PRS

# ---- Runtime data ----------------------------------------------------------
# The default root is ~/Documents/Grex VSTI, i.e. OUTSIDE the repo - but
# LOCATE SYSTEM FOLDER can be pointed anywhere, including at the project root,
# so the folder and everything it writes are ignored here as well.
Grex VSTI/
instruments_presets/
style_instruments_presets/
sets/
midi maps/
*.bset
*.ins
*.sins
*.drm
*.grxsong
*.grexmidi
*.dsin
*.grexv

# ---- Plugin-written settings / diagnostics ---------------------------------
# Everything Grex writes is grex_* (grex_boost.xml, grex_funkey.xml, ...).
grex_*.xml
grex_*.txt

# ---- Packaged artefacts ----------------------------------------------------
*.zip
*.7z
*.rar
*.exe
*.msi
*.dmg
*.pkg
*.vst3
*.clap
*.component

# ---- Signing material - MUST never be committed ----------------------------
*.p12
*.pfx
*.cer
*.certSigningRequest
*.mobileprovision
*_base64
mac_cert_base64
entitlements.plist

# ---- Logs and backups ------------------------------------------------------
*.log
backup*/
*.bak
*~

# ---- OS noise --------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
